<jasperReport name="laporan_pelanggan" language="java" pageWidth="595" pageHeight="842" columnWidth="515" leftMargin="40" rightMargin="40" topMargin="30" bottomMargin="30">
	<parameter name="judul" class="java.lang.String"/>
	<parameter name="instansi" class="java.lang.String"/>
	<parameter name="alamat" class="java.lang.String"/>
	<parameter name="kontak" class="java.lang.String"/>
	<parameter name="periode" class="java.lang.String"/>
	<parameter name="summary" class="java.lang.String"/>
	<field name="no" class="java.lang.Integer"/>
	<field name="nama" class="java.lang.String"/>
	<field name="jumlah" class="java.lang.Long"/>
	<field name="omzet" class="java.math.BigDecimal"/>
	<title height="90">
		<element kind="textField" x="0" y="0" width="515" height="18" fontSize="14.0" bold="true" hTextAlign="Center"><expression><![CDATA[$P{instansi}]]></expression></element>
		<element kind="textField" x="0" y="18" width="515" height="14" hTextAlign="Center"><expression><![CDATA[$P{alamat}]]></expression></element>
		<element kind="textField" x="0" y="32" width="515" height="14" hTextAlign="Center"><expression><![CDATA[$P{kontak}]]></expression></element>
		<element kind="textField" x="0" y="52" width="515" height="16" fontSize="12.0" bold="true" hTextAlign="Center"><expression><![CDATA[$P{judul}]]></expression></element>
		<element kind="textField" x="0" y="68" width="515" height="14" hTextAlign="Center"><expression><![CDATA[$P{periode}]]></expression></element>
	</title>
	<columnHeader height="18">
		<element kind="staticText" x="0" y="0" width="40" height="18" bold="true"><text><![CDATA[No]]></text></element>
		<element kind="staticText" x="40" y="0" width="245" height="18" bold="true"><text><![CDATA[Nama Pelanggan]]></text></element>
		<element kind="staticText" x="285" y="0" width="110" height="18" bold="true" hTextAlign="Right"><text><![CDATA[Jumlah Transaksi]]></text></element>
		<element kind="staticText" x="395" y="0" width="120" height="18" bold="true" hTextAlign="Right"><text><![CDATA[Total Omzet]]></text></element>
	</columnHeader>
	<detail>
		<band height="16">
			<element kind="textField" x="0" y="0" width="40" height="16"><expression><![CDATA[$F{no}]]></expression></element>
			<element kind="textField" x="40" y="0" width="245" height="16"><expression><![CDATA[$F{nama}]]></expression></element>
			<element kind="textField" x="285" y="0" width="110" height="16" hTextAlign="Right"><expression><![CDATA[$F{jumlah}]]></expression></element>
			<element kind="textField" x="395" y="0" width="120" height="16" hTextAlign="Right" pattern="#,##0.00"><expression><![CDATA[$F{omzet}]]></expression></element>
		</band>
	</detail>
	<summary height="20">
		<element kind="textField" x="0" y="4" width="515" height="16" bold="true" hTextAlign="Right"><expression><![CDATA[$P{summary}]]></expression></element>
	</summary>
</jasperReport>