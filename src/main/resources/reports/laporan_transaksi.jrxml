<jasperReport name="laporan_transaksi" language="java" pageWidth="595" pageHeight="842" columnWidth="515" leftMargin="40" rightMargin="40" topMargin="30" bottomMargin="30">
	<parameter name="judul" class="java.lang.String"/>
	<parameter name="instansi" class="java.lang.String"/>
	<parameter name="alamat" class="java.lang.String"/>
	<parameter name="kontak" class="java.lang.String"/>
	<parameter name="periode" class="java.lang.String"/>
	<parameter name="summary" class="java.lang.String"/>
	<field name="no" class="java.lang.Integer"/>
	<field name="nomor" class="java.lang.String"/>
	<field name="tanggal" class="java.lang.String"/>
	<field name="pelanggan" class="java.lang.String"/>
	<field name="kasir" class="java.lang.String"/>
	<field name="total" class="java.math.BigDecimal"/>
	<title height="90">
		<element kind="textField" x="0" y="0" width="515" height="18" fontSize="14.0" bold="true" hTextAlign="Center">
			<expression><![CDATA[$P{instansi}]]></expression>
		</element>
		<element kind="textField" x="0" y="18" width="515" height="14" hTextAlign="Center">
			<expression><![CDATA[$P{alamat}]]></expression>
		</element>
		<element kind="textField" x="0" y="32" width="515" height="14" hTextAlign="Center">
			<expression><![CDATA[$P{kontak}]]></expression>
		</element>
		<element kind="textField" x="0" y="52" width="515" height="16" fontSize="12.0" bold="true" hTextAlign="Center">
			<expression><![CDATA[$P{judul}]]></expression>
		</element>
		<element kind="textField" x="0" y="68" width="515" height="14" hTextAlign="Center">
			<expression><![CDATA[$P{periode}]]></expression>
		</element>
	</title>
	<columnHeader height="18">
		<element kind="staticText" x="0" y="0" width="25" height="18" bold="true"><text><![CDATA[No]]></text></element>
		<element kind="staticText" x="25" y="0" width="95" height="18" bold="true"><text><![CDATA[Nomor]]></text></element>
		<element kind="staticText" x="120" y="0" width="90" height="18" bold="true"><text><![CDATA[Tanggal]]></text></element>
		<element kind="staticText" x="210" y="0" width="120" height="18" bold="true"><text><![CDATA[Pelanggan]]></text></element>
		<element kind="staticText" x="330" y="0" width="100" height="18" bold="true"><text><![CDATA[Kasir]]></text></element>
		<element kind="staticText" x="430" y="0" width="85" height="18" bold="true" hTextAlign="Right"><text><![CDATA[Total]]></text></element>
	</columnHeader>
	<detail>
		<band height="16">
			<element kind="textField" x="0" y="0" width="25" height="16"><expression><![CDATA[$F{no}]]></expression></element>
			<element kind="textField" x="25" y="0" width="95" height="16"><expression><![CDATA[$F{nomor}]]></expression></element>
			<element kind="textField" x="120" y="0" width="90" height="16"><expression><![CDATA[$F{tanggal}]]></expression></element>
			<element kind="textField" x="210" y="0" width="120" height="16"><expression><![CDATA[$F{pelanggan}]]></expression></element>
			<element kind="textField" x="330" y="0" width="100" height="16"><expression><![CDATA[$F{kasir}]]></expression></element>
			<element kind="textField" x="430" y="0" width="85" height="16" hTextAlign="Right" pattern="#,##0.00"><expression><![CDATA[$F{total}]]></expression></element>
		</band>
	</detail>
	<summary height="20">
		<element kind="textField" x="0" y="4" width="515" height="16" bold="true" hTextAlign="Right">
			<expression><![CDATA[$P{summary}]]></expression>
		</element>
	</summary>
</jasperReport>